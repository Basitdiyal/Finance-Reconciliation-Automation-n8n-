      "name": "Email Writer"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a highly accurate data extraction API. Your sole function is to identify a booking number from a transaction description and return it in a structured JSON format.\n\nThe booking number format is typically \"BK\" followed by digits, but can have variations like hyphens or different cases.\n\nAnalyze the user-provided description and respond with ONLY a valid JSON object.\n\nThe JSON object must contain one key: \"booking_id\".\n- If a booking number is found, its value should be the extracted number as a string.\n- If no booking number is found, its value should be null.\n\n## EXAMPLES ##\nDescription: \"Payment for booking BK1001, thank you\"\n{\n  \"booking_id\": \"BK1001\"\n}\n\nDescription: \"Advance received inv-bk-1005\"\n{\n  \"booking_id\": \"bk-1005\"\n}\n\nDescription: \"Miscellaneous income deposit\"\n{\n  \"booking_id\": null\n}\n## END EXAMPLES ##\n\nDescription: {{$json[\"Description\"]}}",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        208,
        -240
      ],
      "id": "111974fc-a196-4a0a-8721-a39437e024bf",
